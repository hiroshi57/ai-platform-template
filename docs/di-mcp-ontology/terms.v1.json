{
  "$comment": "DI-MCP オントロジー 初期定義ストア v1（提案 harness-proposals/2026-09-28-evoontology-gated-ontology-layer.md §3）。媒体側の列名は各 API の公開仕様に基づく候補で、evidence.status=unverified のものは DI-MCP 側の確認クエリ（probe）で確かめるまで『未確認』として扱う。実値・アカウントID・クライアント名は書かない（secret-isolation.md ルール2・6）。",
  "schema_version": "ontology-terms.v1",
  "store_version": "2026-09-28.1",
  "node_families": ["term", "mapping", "constraint", "evidence"],
  "relation_types": ["association", "hierarchy", "composition", "equivalence", "derivation"],
  "terms": [
    {
      "id": "cost",
      "name": "費用",
      "kind": "metric",
      "unit": "JPY",
      "description": "広告の消化金額（税抜）。",
      "mappings": {
        "google_ads": { "field": "metrics.cost_micros", "transform": "divide:1000000" },
        "meta_ads": { "field": "spend" },
        "ga4": null
      },
      "constraints": [
        "Google 広告の cost_micros はマイクロ単位。円にするには 1,000,000 で割る。",
        "税込/税抜を混在させない。本ストアは税抜で定義する。",
        "表示用に万円などへ丸めた値を計算に使う場合は、単位を明示して円に戻してから使う。"
      ],
      "evidence": [{ "status": "unverified", "note": "DI-MCP 側 probe 待ち" }],
      "relations": []
    },
    {
      "id": "impressions",
      "name": "表示回数（IMP）",
      "kind": "metric",
      "unit": "count",
      "description": "広告が表示された回数。",
      "mappings": {
        "google_ads": { "field": "metrics.impressions" },
        "meta_ads": { "field": "impressions" },
        "ga4": null
      },
      "constraints": [],
      "evidence": [{ "status": "unverified", "note": "DI-MCP 側 probe 待ち" }],
      "relations": []
    },
    {
      "id": "clicks",
      "name": "クリック数",
      "kind": "metric",
      "unit": "count",
      "description": "広告のクリック数。",
      "mappings": {
        "google_ads": { "field": "metrics.clicks" },
        "meta_ads": { "field": "clicks" },
        "ga4": null
      },
      "constraints": [
        "Meta の clicks はリンク以外のクリックも含む。リンククリックに限る場合は別の用語として定義する。"
      ],
      "evidence": [{ "status": "unverified", "note": "DI-MCP 側 probe 待ち" }],
      "relations": []
    },
    {
      "id": "cv",
      "name": "コンバージョン（CV）",
      "kind": "metric",
      "unit": "count",
      "description": "成果として計測された件数。",
      "mappings": {
        "google_ads": { "field": "metrics.conversions" },
        "meta_ads": { "field": "actions", "filter": "action_type = <アカウント設定の CV イベント>" },
        "ga4": { "field": "keyEvents" }
      },
      "constraints": [
        "媒体ごとに計測の定義（アトリビューション・計測期間）が違う。媒体をまたいで単純に合計しない。",
        "Meta の CV イベントはアカウントの設定で決まる。推測で埋めない（DI-MCP の既存規約）。",
        "広告媒体の CV と GA4 の keyEvents は一致しない前提で扱う。"
      ],
      "evidence": [{ "status": "unverified", "note": "DI-MCP 側 probe 待ち" }],
      "relations": []
    },
    {
      "id": "revenue",
      "name": "売上（CV 値）",
      "kind": "metric",
      "unit": "JPY",
      "description": "コンバージョンに紐づく売上金額。",
      "mappings": {
        "google_ads": { "field": "metrics.conversions_value" },
        "meta_ads": { "field": "action_values", "filter": "action_type = <アカウント設定の CV イベント>" },
        "ga4": { "field": "totalRevenue" }
      },
      "constraints": [
        "cv と同じく媒体ごとに計測の定義が違う。媒体をまたいで単純に合計しない。"
      ],
      "evidence": [{ "status": "unverified", "note": "DI-MCP 側 probe 待ち" }],
      "relations": []
    },
    {
      "id": "sessions",
      "name": "セッション",
      "kind": "metric",
      "unit": "count",
      "description": "サイト上のセッション数。",
      "mappings": {
        "google_ads": null,
        "meta_ads": null,
        "ga4": { "field": "sessions" }
      },
      "constraints": [
        "広告のクリック数とは一致しない前提で扱う。"
      ],
      "evidence": [{ "status": "unverified", "note": "DI-MCP 側 probe 待ち" }],
      "relations": []
    },
    {
      "id": "ctr",
      "name": "クリック率（CTR）",
      "kind": "metric",
      "unit": "percent",
      "description": "クリック数 ÷ 表示回数 × 100。",
      "formula": { "type": "ratio", "numerator": "clicks", "denominator": "impressions", "scale": 100, "on_zero_denominator": 0 },
      "mappings": {},
      "constraints": [
        "集計するときは各行の CTR を平均しない。clicks と impressions をそれぞれ合計してから割る。"
      ],
      "evidence": [],
      "relations": [
        { "type": "derivation", "from": "clicks" },
        { "type": "derivation", "from": "impressions" }
      ]
    },
    {
      "id": "cvr",
      "name": "コンバージョン率（CVR）",
      "kind": "metric",
      "unit": "percent",
      "description": "CV ÷ クリック数 × 100。",
      "formula": { "type": "ratio", "numerator": "cv", "denominator": "clicks", "scale": 100, "on_zero_denominator": 0 },
      "mappings": {},
      "constraints": [
        "集計するときは各行の CVR を平均しない。cv と clicks をそれぞれ合計してから割る。",
        "cv の媒体差（上記）をそのまま引き継ぐ。"
      ],
      "evidence": [],
      "relations": [
        { "type": "derivation", "from": "cv" },
        { "type": "derivation", "from": "clicks" }
      ]
    },
    {
      "id": "cpa",
      "name": "獲得単価（CPA）",
      "kind": "metric",
      "unit": "JPY",
      "description": "費用 ÷ CV。",
      "formula": { "type": "ratio", "numerator": "cost", "denominator": "cv", "scale": 1, "on_zero_denominator": 0, "round": "integer" },
      "mappings": {},
      "constraints": [
        "cost は円単位で渡す。万円などで持っている場合は呼び出し側で円に戻す。",
        "集計するときは各行の CPA を平均しない。cost と cv をそれぞれ合計してから割る。",
        "CV が 0 のときは 0 を返す（無限大として扱わない）。"
      ],
      "evidence": [],
      "relations": [
        { "type": "derivation", "from": "cost" },
        { "type": "derivation", "from": "cv" }
      ]
    },
    {
      "id": "roas",
      "name": "広告費用対効果（ROAS）",
      "kind": "metric",
      "unit": "percent",
      "description": "売上 ÷ 費用 × 100。",
      "formula": { "type": "ratio", "numerator": "revenue", "denominator": "cost", "scale": 100, "on_zero_denominator": 0, "round": "integer" },
      "mappings": {},
      "constraints": [
        "集計するときは各行の ROAS を単純平均しない。revenue と cost をそれぞれ合計してから割る（費用で重み付けした平均と同じ）。",
        "revenue と cost は同じ単位で渡す。"
      ],
      "evidence": [],
      "relations": [
        { "type": "derivation", "from": "revenue" },
        { "type": "derivation", "from": "cost" }
      ]
    }
  ]
}
